# =============================================================================
# Tilley Station demo — root .env template: SECRETS + runtime knobs only.
#
# Domain constants (station capacity, evacuation flow, aggregation window,
# control thresholds) live once in demo.config.json. Cloud infra AND non-secret
# Bedrock config (region, model id, connection name) live once in
# terraform/vars.tf. This file holds only secrets + Python runtime knobs.
#
# Copy to .env and fill in; the real .env is git-ignored. Plain KEY=VALUE lines
# (no `export`) so `env_file: .env` works in Docker Compose AND
# `set -a; source .env; set +a` exports them for Terraform / the Confluent CLI.
# =============================================================================

# --- Confluent Cloud (Terraform provider auth) -------------------------------
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- AWS keys for the Bedrock connection (Terraform vars; only needed for AI) -
# Consumed by terraform var.aws_access_key / var.aws_secret_key. Leave the
# session token empty unless you use temporary STS credentials.
TF_VAR_aws_access_key=
TF_VAR_aws_secret_key=
TF_VAR_aws_session_token=

# --- Kafka + Schema Registry (written automatically by `terraform apply`) -----
# Populated in place by terraform/write_env.sh; no need to edit these by hand.
BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- Runtime (Python emulator + backend) -------------------------------------
CONSUMER_GROUP=tilley-demo-backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# SocketIO async mode: 'threading' (default, robust with blocking Kafka) or 'eventlet'
SOCKETIO_ASYNC_MODE=threading

# --- Demo-speed generation (emulator only — liveliness over realism) ---------
FOOT_MIN=1
FOOT_MAX=40
TRAIN_MIN=10
TRAIN_MAX=40
DWELL_MIN=8
DWELL_MAX=20
BOARD_FRACTION=0.35

# --- On-demand surge (presenter-triggered via demo_control) ------------------
SURGE_FACTOR=5
SURGE_DURATION=45
AUTO_SURGE_AFTER=0
