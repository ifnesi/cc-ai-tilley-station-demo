# =============================================================================
# Tilley Station demo — root .env template: SECRETS + all runtime config.
#
# Every configurable value lives here; the Python apps read it via .env. The
# ONLY other place variables live is terraform/vars.tf (Terraform's own copy of
# cloud-infra settings + the domain constants). On `terraform apply`,
# terraform/write_env.sh updates the Kafka/Schema-Registry connection details AND
# the resolved domain constants IN PLACE in your .env, so Python and Flink always
# use the same numbers. Nothing is hard-coded in the Python source.
#
# Copy to .env and fill in the secrets; the real .env is git-ignored. Plain
# KEY=VALUE lines (values with spaces are quoted) so `env_file: .env` works in
# Docker Compose AND `set -a; source .env; set +a` exports them for Terraform /
# the Confluent CLI.
# =============================================================================

# --- Confluent Cloud (Terraform provider auth) -------------------------------
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- AWS keys for the Bedrock connection (Terraform vars; only needed for AI) -
# Consumed by terraform var.aws_access_key / var.aws_secret_key. Leave the
# session token empty unless you use temporary STS credentials.
TF_VAR_aws_access_key=
TF_VAR_aws_secret_key=
TF_VAR_aws_session_token=

# --- Kafka + Schema Registry (written automatically by `terraform apply`) -----
# Populated in place by terraform/write_env.sh; no need to edit these by hand.
BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- Managed MCP for Claude Code (Real-Time Context Engine) ------------------
# CC_MCP_URL is written by `terraform apply` (the regional, cluster-scoped
# context-engine endpoint) and referenced by the repo-root .mcp.json.
CC_MCP_URL=
# CC_MCP_AUTH is a SECRET and is NOT stored here — create a GLOBAL Cloud API key
# owned by the mcp-reader service account (terraform output
# mcp_reader_service_account), then before launching Claude Code from the repo
# root run:  export CC_MCP_AUTH="$(printf '%s:%s' <GLOBAL_KEY> <GLOBAL_SECRET> | base64)"

# --- Domain constants (also written by `terraform apply` from terraform/vars.tf)
# The Python apps read these; Flink templates its SQL from the same values in
# vars.tf. The defaults below let the apps + tests run before you apply.
STATION_NAME="Tilley Station"
STATION_CAPACITY=1200
AGG_WINDOW_SECONDS=5
PCT_LOW=0.70
PCT_HIGH=0.85
PCT_CRITICAL=0.95

# --- Backend (Flask + Socket.IO) ---------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# SocketIO async mode: 'threading' (default, robust with blocking Kafka) or 'eventlet'.
SOCKETIO_ASYNC_MODE=threading

# --- Emulator: demo-speed generation (liveliness over realism) ---------------
FOOT_MIN=1
FOOT_MAX=40
TRAIN_MIN=10
TRAIN_MAX=40
DWELL_MIN=8
DWELL_MAX=20
BOARD_FRACTION=0.35
CONSUMER_GROUP=tilley-demo

# Starting occupancy AND the level RESET returns to, as a fraction of capacity.
# 0.0 = empty, 0.45 = default (~540 of 1200, a healthy mid-band). Clamped to [0,1].
INITIAL_OCCUPANCY_FRACTION=0.45

# --- On-demand surge (presenter-triggered via demo_control) ------------------
SURGE_FACTOR=5
SURGE_DURATION=45
AUTO_SURGE_AFTER=0
