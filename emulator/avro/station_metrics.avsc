{
  "type": "record",
  "name": "station_metrics",
  "namespace": "tilley",
  "doc": "Wide, one row per tumbling window (default 15s). Windowed crowd metrics feeding the charts, anomaly detection and AI advisor.",
  "fields": [
    { "name": "station_name", "type": "string", "default": "", "doc": "Per-station key, carried through so downstream OVER windows (anomalies, AI) partition on a real column, not a constant." },
    { "name": "window_start", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "window_end", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "foot_in", "type": "int", "doc": "SUM(passengers_flow.passengers)." },
    { "name": "alight_wait", "type": "int", "doc": "SUM(passengers_station) - joins occupancy." },
    { "name": "alight_exit", "type": "int", "doc": "SUM(passengers_out) - pass-through." },
    { "name": "alight_total", "type": "int", "doc": "SUM(passengers_out + passengers_station)." },
    { "name": "board_total", "type": "int", "doc": "SUM(passengers_boarding) - leaves occupancy." },
    { "name": "alight_east", "type": "int", "doc": "alight_total for east_bound trains." },
    { "name": "alight_west", "type": "int", "doc": "alight_total for west_bound trains." },
    { "name": "board_east", "type": "int", "doc": "board_total for east_bound trains." },
    { "name": "board_west", "type": "int", "doc": "board_total for west_bound trains." },
    { "name": "net_change", "type": "int", "doc": "foot_in + alight_wait - board_total." },
    { "name": "occupancy", "type": "int", "doc": "Latest station_occupancy snapshot in the window." },
    { "name": "occupancy_pct", "type": "double", "doc": "occupancy / capacity." },
    { "name": "evac_time", "type": "double", "doc": "occupancy / evacuation_flow (seconds to clear - the safety KPI)." }
  ]
}
